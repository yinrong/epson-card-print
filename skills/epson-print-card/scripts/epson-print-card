#!/usr/bin/env python3
"""证卡（PVC 卡）组批打印：目录正面图＋共享背面图，2 卡托盘分组，正/背面之间设干燥门控。

用法核心：
  epson-print-card prepare --front-dir DIR --back-img PATH --group 2x5 --profile P --output JOBDIR
  epson-print-card step --job JOBDIR --queue NAME [--execute --tray-loaded] [--confirm-output] [--confirm-dry]

--group 2x5 含义：每托盘 2 张卡（原配托盘，数量不能变），每批 5 个托盘（10 张卡）。
批次流程：逐盘打印正面 → 全批干燥（--confirm-dry）→ 翻卡逐盘打印背面 → 再次干燥 → 换下一批。
"""
import argparse
import datetime as dt
import hashlib
import html
import importlib.metadata
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

PT = 72 / 25.4
IDENTITY = [1, 0, 0, 0, 1, 0]  # x'=a*x+b*y+c, y'=d*x+e*y+f
IMAGE_SUFFIXES = {'.png', '.jpg', '.jpeg', '.tif', '.tiff', '.bmp', '.webp'}

# 本项目 PVC 证卡只有一种规格：86x54 mm 卡、原配双卡托架。坐标来自 L8050 驱动
# 静态资料推算（候选值，未经 L8058 实机验证）；实机校准结果写在
# ~/.config/epson-print-card/profile.json，存在即优先生效。
DEFAULT_PROFILE = {
    "name": "L8058 stock two-slot (built-in)",
    "page_mm": [209.9733333333, 296.9683333333],
    "inset_mm": 3,
    "slots": [
        {"id": "S1", "x": 10.677, "y": 38.739, "w": 54, "h": 86, "rotation": 90},
        {"id": "S2", "x": 85.183, "y": 38.739, "w": 54, "h": 86, "rotation": 90}
    ],
    "back_slot_map": ["S1", "S2"],
    "back_rotation": 0,
    "transforms": {"front": [1, 0, 0, 0, 1, 0], "back": [1, 0, 0, 0, 1, 0]},
    "cups_options": {},
    "queue_name": None,
    "tray_option": None,
    "transport_verified": False,
    "production_verified": False,
    "verification_evidence": [],
    "basis": "L8050 Mac 13.26 MediaID199 clipping rectangles interpreted at 360dpi; nominal 54x86 card centered in 56.02x87.98 clip. Page from 595.20x841.80 points. Neither L8058 page origin nor tray transport has been verified. These are calibration candidates, not known print coordinates.",
    "physical_card_thickness_mm": 0.76,
    "physical_card_evidence": "User reports successful printing on original tray with nominal 0.76 mm cards; does not verify this custom program."
}


def active_profile_path():
    base = os.environ.get('EPSON_PRINT_CARD_CONFIG_DIR', str(Path.home()/'.config'/'epson-print-card'))
    return Path(base)/'profile.json'


def active_profile():
    import copy
    path = active_profile_path()
    if path.is_file():
        return validate(read(path))
    return validate(copy.deepcopy(DEFAULT_PROFILE))


def read(path):
    return json.loads(Path(path).read_text())


def write(path, obj):
    path = Path(path)
    with tempfile.NamedTemporaryFile('w', dir=path.parent, delete=False) as f:
        json.dump(obj, f, ensure_ascii=False, indent=2, allow_nan=False)
        f.write('\n')
        temp = f.name
    os.replace(temp, path)


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def num(value, label, low=None):
    if isinstance(value, bool) or not isinstance(value, (float, int)) or not math.isfinite(value):
        raise ValueError(f'{label}: finite number required')
    if low is not None and value < low:
        raise ValueError(f'{label}: minimum {low}')
    return value


def point(m, x, y):
    a, b, c, d, e, f = m
    return [a*x+b*y+c, d*x+e*y+f]


def validate(profile):
    width, height = profile['page_mm']
    num(width, 'page width', 1); num(height, 'page height', 1)
    if width > 1000 or height > 1000:
        raise ValueError('Page exceeds 1000 mm')
    slots = profile['slots']
    if not slots or len(slots) > 100:
        raise ValueError('Need 1..100 slots')
    ids = [s['id'] for s in slots]
    if len(ids) != len(set(ids)) or any(not isinstance(i, str) or not i for i in ids):
        raise ValueError('Slot IDs must be unique strings')
    for s in slots:
        for k in ('x', 'y', 'w', 'h'):
            num(s[k], f'{s["id"]}.{k}', 0 if k in ('x', 'y') else .1)
        if s['x']+s['w'] > width or s['y']+s['h'] > height:
            raise ValueError(f'Slot outside page: {s["id"]}')
        if s.get('rotation', 0) not in (0, 90, 180, 270):
            raise ValueError('Slot rotation must be clockwise 0/90/180/270')
        margin = num(profile.get('inset_mm', 3), 'inset', 0)
        if margin*2 >= min(s['w'], s['h']):
            raise ValueError('Inset consumes card')
    for i, s in enumerate(slots):
        for t in slots[i+1:]:
            if min(s['x']+s['w'], t['x']+t['w']) > max(s['x'], t['x']) and min(s['y']+s['h'], t['y']+t['h']) > max(s['y'], t['y']):
                raise ValueError(f'Overlapping slots: {s["id"]}, {t["id"]}')
    mapping = profile.get('back_slot_map', ids)
    if len(mapping) != len(ids) or set(mapping) != set(ids):
        raise ValueError('back_slot_map must be a permutation of slot IDs')
    for i, name in enumerate(mapping):
        t = next(s for s in slots if s['id'] == name)
        if (slots[i]['w'], slots[i]['h']) != (t['w'], t['h']):
            raise ValueError('Back mapping requires matching oriented slot dimensions')
    if not 0 <= num(profile.get('bleed_mm', 0), 'bleed') <= 3:
        raise ValueError('bleed_mm must be 0..3')
    if profile.get('back_rotation', 0) not in (0, 180):
        raise ValueError('back_rotation must be 0 or 180')
    for side in ('front', 'back'):
        m = profile.get('transforms', {}).get(side, IDENTITY)
        if len(m) != 6:
            raise ValueError('Affine transform needs six numbers')
        for v in m:
            num(v, 'transform')
        if m[0]*m[4]-m[1]*m[3] <= 0:
            raise ValueError('Transform must preserve orientation')
        for s in slots:
            for x in (s['x'], s['x']+s['w']):
                for y in (s['y'], s['y']+s['h']):
                    xx, yy = point(m, x, y)
                    if not (-.001 <= xx <= width+.001 and -.001 <= yy <= height+.001):
                        raise ValueError('Calibrated slot falls outside PDF page')
    return profile


def parse_group(spec):
    m = re.fullmatch(r'(\d+)[xX×](\d+)', str(spec or '').strip())
    if not m:
        raise ValueError('--group must look like 2x5 (slots per tray x trays per batch)')
    slots, trays = int(m[1]), int(m[2])
    if slots != 2:
        raise ValueError('this workflow uses the stock 2-card tray; slots per tray cannot change (got %d)' % slots)
    if not 1 <= trays <= 100:
        raise ValueError('trays per batch must be 1..100')
    return slots, trays


def load_cards(front_dir, back_img):
    front_dir = Path(front_dir).resolve()
    if not front_dir.is_dir():
        raise ValueError(f'Not a directory: {front_dir}')
    back = Path(back_img).resolve()
    if not back.is_file():
        raise ValueError(f'Missing back image: {back}')
    files = sorted(p for p in front_dir.iterdir() if p.is_file() and p.suffix.lower() in IMAGE_SUFFIXES)
    if not files:
        raise ValueError(f'No images found in {front_dir}')
    cards, seen = [], set()
    for f in files:
        card_id = f.stem
        if card_id in seen:
            raise ValueError(f'Duplicate card id from filename stem: {card_id}')
        seen.add(card_id)
        cards.append({'id': card_id, 'front': str(f), 'back': str(back)})
    if len(cards) > 10000:
        raise ValueError('At most 10000 cards per job')
    return cards


def fitted(path, size, fit, rotation):
    from PIL import Image, ImageOps
    with Image.open(path) as source:
        source.load()
        im = ImageOps.exif_transpose(source).convert('RGBA')
    background = Image.new('RGBA', im.size, 'white')
    background.alpha_composite(im)
    im = background.convert('RGB').rotate(-rotation, expand=True)
    if fit == 'cover':
        return ImageOps.fit(im, size, method=Image.Resampling.LANCZOS)
    if fit == 'exact':
        return im.resize(size, Image.Resampling.LANCZOS)
    if fit == 'contain':
        scaled = ImageOps.contain(im, size, method=Image.Resampling.LANCZOS)
        canvas = Image.new('RGB', size, 'white')
        canvas.paste(scaled, ((size[0]-scaled.width)//2, (size[1]-scaled.height)//2))
        return canvas
    raise ValueError('fit must be cover or contain')


BLEED = 4


def text(c, x, y, s, size, center=False):
    c.saveState(); c.translate(x, y); c.scale(1, -1); c.setFont('Helvetica-Bold', size)
    (c.drawCentredString if center else c.drawString)(0, -size*.35, s)
    c.restoreState()


def ruler_card(c, slot, side, page_w, page_h):
    """Edge rulers: 0 on the nominal card edge, positive values toward the card centre."""
    x0, y0, w, h = slot['x'], slot['y'], slot['w'], slot['h']
    bx, by = max(0, x0-BLEED), max(0, y0-BLEED)
    clip = c.beginPath(); clip.rect(bx, by, min(page_w, x0+w+BLEED)-bx, min(page_h, y0+h+BLEED)-by)
    c.clipPath(clip, stroke=0)
    c.setStrokeColorRGB(.8, .8, .8); c.setLineWidth(.1)
    for gx in range(-BLEED, int(w)+BLEED+1, 5):
        c.line(x0+gx, y0-BLEED, x0+gx, y0+h+BLEED)
    for gy in range(-BLEED, int(h)+BLEED+1, 5):
        c.line(x0-BLEED, y0+gy, x0+w+BLEED, y0+gy)
    c.setStrokeColorRGB(1, 0, 0); c.setLineWidth(.2); c.rect(x0, y0, w, h)
    c.setStrokeColorRGB(0, 0, 0); c.setFillColorRGB(0, 0, 0)
    cx, cy = x0+w/2, y0+h/2
    # (edge point, inward unit vector, tangent unit vector)
    edges = [((x0, cy), (1, 0), (0, 1)), ((x0+w, cy), (-1, 0), (0, 1)),
             ((cx, y0), (0, 1), (1, 0)), ((cx, y0+h), (0, -1), (1, 0))]
    for (ex, ey), (ix, iy), (tx, ty) in edges:
        for k in range(-2*BLEED, 2*8+1):
            v = k/2
            length = 3 if k % 2 == 0 else 1.5
            px, py = ex+ix*v, ey+iy*v
            c.setLineWidth(.2 if k else .35)
            c.line(px-tx*length, py-ty*length, px+tx*length, py+ty*length)
            if k % 4 == 0 and v != 0:
                text(c, px+tx*(length+1.6), py+ty*(length+1.6), f'{v:g}', 2.2, center=True)
        text(c, ex+ix*.0+tx*5.5, ey+iy*.0+ty*5.5, '0', 2.2, center=True)
    c.setLineWidth(.2)
    c.line(cx-3, cy, cx+3, cy); c.line(cx, cy-3, cx, cy+3)
    text(c, cx, cy-14, f'{slot["id"]} {side.upper()}', 4, center=True)
    text(c, cx, cy+14, 'PAGE TOP ^', 3, center=True)
    c.line(cx, cy+20, cx, cy+28); c.line(cx, cy+20, cx-2, cy+23); c.line(cx, cy+20, cx+2, cy+23)


def make_pdf(path, profile, placements, side, dpi, fit, calibration=False):
    from reportlab.pdfgen import canvas
    from reportlab.lib.utils import ImageReader
    width, height = profile['page_mm']
    c = canvas.Canvas(str(path), pagesize=(width*PT, height*PT), pageCompression=1)
    c.setTitle(f'{profile["name"]} {side}')
    c.translate(0, height*PT)
    c.scale(PT, -PT)
    a, b, cc, d, e, f = profile.get('transforms', {}).get(side, IDENTITY)
    c.transform(a, d, b, e, cc, f)
    # Negative effective inset = bleed beyond the card edge, hiding residual placement error.
    inset = profile.get('inset_mm', 3) - profile.get('bleed_mm', 0)
    for placement in placements:
        slot = placement['slot']
        x, y = slot['x']+inset, slot['y']+inset
        w, h = slot['w']-2*inset, slot['h']-2*inset
        c.saveState()
        if calibration:
            ruler_card(c, slot, side, width, height)
            c.restoreState()
            continue
        clip = c.beginPath(); clip.rect(x, y, w, h); c.clipPath(clip, stroke=0)
        rotation = slot.get('rotation', 0) + (profile.get('back_rotation', 0) if side == 'back' else 0)
        pixels = (max(1,round(w*dpi/25.4)), max(1,round(h*dpi/25.4)))
        if fit == 'exact':
            # Card art at 1:1 inside the nominal card area; bleed repeats the edge pixels outward.
            bleed = profile.get('bleed_mm', 0)
            b = round(bleed*dpi/25.4)
            core = fitted(placement['card'][side], (pixels[0]-2*b, pixels[1]-2*b), fit, rotation)
            from PIL import Image
            import numpy as np
            im = Image.fromarray(np.pad(np.asarray(core), ((b, b), (b, b), (0, 0)), mode='edge'))
        else:
            im = fitted(placement['card'][side], pixels, fit, rotation)
        c.translate(x, y+h); c.scale(1,-1)
        c.drawImage(ImageReader(im),0,0,width=w,height=h)
        c.restoreState()
    c.showPage(); c.save()


def prepare(args):
    slots_per_tray, trays_per_group = parse_group(args.group)
    profile = active_profile()
    if len(profile['slots']) != slots_per_tray:
        raise ValueError(f'active profile has {len(profile["slots"])} slots but --group says {slots_per_tray} per tray')
    if args.calibration:
        cards = [{'id':'calibration-'+s['id'],'front':None,'back':None} for s in profile['slots']]
    else:
        if not args.front_dir or not args.back_img:
            raise ValueError('--front-dir and --back-img are required (or use --calibration)')
        cards = load_cards(args.front_dir, args.back_img)
    output = Path(args.output).resolve()
    output.mkdir(parents=True, exist_ok=False)
    # Manifest appears only after every file is complete. Failed folders are not runnable.
    capacity = len(profile['slots'])
    mapping = profile.get('back_slot_map', [s['id'] for s in profile['slots']])
    by_id = {s['id']:s for s in profile['slots']}
    manifest = {'schema':2,'mode':'card-group','group':{'slots_per_tray':slots_per_tray,'trays_per_group':trays_per_group},
                'profile':profile,'calibration':args.calibration,'created_at':dt.datetime.now().astimezone().isoformat(),
                'cards':len(cards),'back_image':cards[0]['back'],'batches':[]}
    manifest['runtime']={'python':sys.version.split()[0],**{name:importlib.metadata.version(name) for name in ('Pillow','reportlab')}}
    for start in range(0,len(cards),capacity):
        index = start//capacity
        group_num = index//trays_per_group+1
        batch_num = index+1
        batch = {'number':batch_num,'group':group_num,'cards':cards[start:start+capacity],'sides':{}}
        for side in ('front','back'):
            placements = [{'card':card,'slot':profile['slots'][i] if side=='front' else by_id[mapping[i]]} for i,card in enumerate(batch['cards'])]
            filename = f'batch-{batch_num:04d}-{side}.pdf'
            path = output/filename
            make_pdf(path,profile,placements,side,args.dpi,args.fit,args.calibration)
            batch['sides'][side] = {'file':filename,'sha256':digest(path),'placements':[{'id':p['card']['id'],'slot':p['slot']['id']} for p in placements]}
        manifest['batches'].append(batch)
    write(output/'manifest.json',manifest)
    write(output/'state.json',{'manifest_sha256':digest(output/'manifest.json'),'next_event':0,'events':[]})
    groups = manifest['batches'][-1]['group'] if manifest['batches'] else 0
    lines = ['<!doctype html><meta charset="utf-8"><title>证卡装卡计划</title><style>body{font:16px system-ui;max-width:960px;margin:32px auto}table{border-collapse:collapse}td,th{border:1px solid #aaa;padding:8px}}</style>',
             f'<h1>证卡组批打印（每托盘 {slots_per_tray} 卡 × 每批 {trays_per_group} 盘）</h1>',
             f'<p>每批顺序：装满 {trays_per_group} 盘 → 逐盘打印正面（每盘确认出盘）→ 整批干燥（--confirm-dry）→ 按背面槽位翻卡装回 → 逐盘打印背面 → 再次干燥（--confirm-dry）→ 换下一批卡。保持托架进机方向一致；图像按正常阅读方向提供，程序不镜像文字。所有卡共用同一张背面图。</p>']
    for g in range(1,groups+1):
        batches=[b for b in manifest['batches'] if b['group']==g]
        lines.append(f'<h2>第 {g} 批（{len(batches)} 盘）</h2><table><tr><th>盘号</th><th>卡号</th><th>正面槽</th><th>背面槽</th></tr>')
        for b in batches:
            for front,back in zip(b['sides']['front']['placements'],b['sides']['back']['placements']):
                lines.append('<tr>'+''.join(f'<td>{html.escape(str(v))}</td>' for v in (b['number'],front['id'],front['slot'],back['slot']))+'</tr>')
        lines.append('</table>')
        for b in batches:
            for side in ('front','back'):
                name=b['sides'][side]['file']
                lines.append(f'<p><a href="{name}">{name}</a></p>')
    (output/'装卡顺序.html').write_text('\n'.join(lines))
    print(json.dumps({'output':str(output),'cards':len(cards),'batches':len(manifest['batches']),'groups':groups,
                      'group_size':slots_per_tray*trays_per_group,'mode':'card-group','calibration':args.calibration,'physical_verified':False},ensure_ascii=False))


def calibrate(args):
    import numpy as np
    path = active_profile_path()
    if args.reset:
        import copy
        path.parent.mkdir(parents=True, exist_ok=True)
        write(path, copy.deepcopy(DEFAULT_PROFILE))
        print(json.dumps({'reset': str(path), 'note': 'active profile restored to built-in spec'}))
        return
    if not args.samples:
        raise ValueError('--samples is required (or use --reset to restore the built-in spec)')
    profile = active_profile()
    samples = read(args.samples)
    if len(samples) < 4:
        raise ValueError('Use at least four measured points, spread across both slots')
    expected = np.array([s['expected_mm'] for s in samples], dtype=float)
    observed = np.array([s['observed_mm'] for s in samples], dtype=float)
    if expected.shape != observed.shape or expected.shape[1:] != (2,) or not np.isfinite(expected).all() or not np.isfinite(observed).all():
        raise ValueError('Each sample needs two finite expected and observed coordinates')
    design = np.column_stack((expected, np.ones(len(samples))))
    coeff,resid,rank,sv = np.linalg.lstsq(design,observed,rcond=None)
    if rank != 3 or np.linalg.cond(design) > 1e6:
        raise ValueError('Calibration points are collinear or poorly spread')
    forward = np.array([[coeff[0,0],coeff[1,0],coeff[2,0]],[coeff[0,1],coeff[1,1],coeff[2,1]],[0,0,1]])
    if np.linalg.det(forward[:2,:2]) <= 0:
        raise ValueError('Reflected observations: check point IDs and flip direction')
    error = np.linalg.norm(design@coeff-observed,axis=1)
    if max(error) > args.max_residual:
        raise ValueError(f'Measurements inconsistent; residual {max(error):.3f} mm')
    # Observations of an already corrected profile require composing old correction.
    old = profile.get('transforms',{}).get('front',IDENTITY)
    old_matrix = np.array([[old[0],old[1],old[2]],[old[3],old[4],old[5]],[0,0,1]])
    correction = old_matrix @ np.linalg.inv(forward)
    m = list(correction[0])+list(correction[1])
    profile.setdefault('transforms',{})['front'] = m
    profile.setdefault('calibration_records',{})['front'] = {'samples':samples,'max_residual_mm':float(max(error)),'status':'computed_pending_repeat_print'}
    # A newly computed correction has not been verified by a repeat print.
    profile['production_verified'] = False
    validate(profile)
    path.parent.mkdir(parents=True, exist_ok=True)
    write(path, profile)
    print(json.dumps({'updated': str(path), 'transform': m, 'max_residual_mm': float(max(error)), 'production_verified': False}))


def checked_run(argv):
    return subprocess.run(argv,check=True,capture_output=True,text=True,timeout=20,env=dict(os.environ,LC_ALL='C',LANG='C'))


def command(profile, queue, pdf):
    if not queue or queue.startswith('-') or not re.fullmatch(r'[A-Za-z0-9_.-]+',queue):
        raise ValueError('Use an explicit local CUPS queue name')
    options = profile.get('cups_options',{})
    forbidden = {'copies','sides','number-up','fit-to-page','scaling','print-scaling','page-ranges','outputorder','job-sheets','orientation-requested','mirror'}
    for key,val in options.items():
        if key.lower() in forbidden or not re.fullmatch(r'[A-Za-z0-9_.-]+',key) or not re.fullmatch(r'[A-Za-z0-9_.,() -]*',str(val)):
            raise ValueError(f'Unsupported option: {key}')
    cmd = ['lp','-d',queue,'-n','1','-o','sides=one-sided','-o','number-up=1','-o','print-scaling=none','-o','fit-to-page=false','-o','job-sheets=none','-o','outputorder=normal']
    for key,val in sorted(options.items()):
        val = str(val)
        cmd += ['-o',f'{key}="{val}"' if ' ' in val or not val else f'{key}={val}']
    return cmd+['--',str(pdf)]


def job_events(manifest):
    """Flat event list: per group, fronts tray by tray, a drying gate, backs tray by tray, a drying gate."""
    events = []
    groups = manifest['batches'][-1]['group'] if manifest['batches'] else 0
    for g in range(1,groups+1):
        batches = [b for b in manifest['batches'] if b['group']==g]
        for b in batches:
            events.append({'type':'side','batch':b['number'],'side':'front'})
        events.append({'type':'dry','group':g,'phase':'backs'})
        for b in batches:
            events.append({'type':'side','batch':b['number'],'side':'back'})
        events.append({'type':'dry','group':g,'phase':'next batch'})
    return events


def describe_event(ev, manifest):
    if ev['type'] == 'dry':
        return f"dry group {ev['group']} before {ev['phase']}"
    batch = manifest['batches'][ev['batch']-1]
    return f"batch {ev['batch']} ({batch['group']}) {ev['side']}"


def step(args):
    folder = Path(args.job).resolve()
    lock = folder/'.state.lock'
    import fcntl
    with lock.open('a') as lockfile:
        fcntl.flock(lockfile,fcntl.LOCK_EX | fcntl.LOCK_NB)
        manifest,state = read(folder/'manifest.json'),read(folder/'state.json')
        if state['manifest_sha256'] != digest(folder/'manifest.json'):
            raise ValueError('Manifest changed; create a new job')
        events = job_events(manifest)
        index = state['next_event']
        if index >= len(events):
            print('All groups printed and dried'); return 'All groups printed and dried'
        ev = events[index]
        pending = state['events'][-1] if state['events'] and state['events'][-1]['index']==index else None
        if ev['type'] == 'dry':
            if args.confirm_output:
                raise ValueError('Current step is a drying gate; use --confirm-dry, not --confirm-output')
            if args.confirm_dry:
                state['next_event'] += 1; write(folder/'state.json',state)
                nxt = events[index+1] if index+1 < len(events) else None
                print(f"Group {ev['group']} dried; next: {describe_event(nxt,manifest) if nxt else 'job complete'}")
                return
            print(json.dumps({'waiting':'drying','group':ev['group'],'before':ev['phase'],
                              'hint':'ink must dry before flipping or swapping cards; pass --confirm-dry to advance'},ensure_ascii=False))
            return
        batch = manifest['batches'][ev['batch']-1]
        side = ev['side']
        spec = batch['sides'][side]; pdf=folder/spec['file']
        if digest(pdf) != spec['sha256']:
            raise ValueError('PDF changed; create a new job')
        if args.confirm_dry:
            raise ValueError('No drying gate pending; --confirm-dry applies only after a whole group side')
        if args.confirm_output:
            if not pending or pending['status'] not in ('submitted','submission_uncertain'):
                raise ValueError('No submitted side to confirm')
            pending['status']='operator_confirmed'; pending['confirmed_at']=dt.datetime.now().astimezone().isoformat()
            state['next_event'] += 1; write(folder/'state.json',state)
            print(f'Confirmed batch {batch["number"]} {side}; use step again for the next tray')
            return
        if pending:
            raise ValueError('Side already submitted or outcome uncertain; inspect printer/CUPS and confirm output. No automatic resend.')
        profile = validate(manifest['profile'])
        cmd = command(profile,args.queue,pdf)
        print(json.dumps({'batch':batch['number'],'group':batch['group'],'side':side,'placements':spec['placements'],'argv':cmd,'execute':args.execute},ensure_ascii=False))
        if not args.execute:
            return
        if not args.tray_loaded:
            raise ValueError('Load the specified tray side, then pass --tray-loaded')
        if not profile.get('transport_verified'):
            raise ValueError('Tray transport/options not verified for this profile')
        if not manifest.get('calibration') and not profile.get('production_verified'):
            raise ValueError('Production profile needs repeat-print evidence; calibration jobs remain available')
        if not profile.get('verification_evidence'):
            raise ValueError('Profile must record transport/print evidence')
        if profile.get('queue_name') != args.queue:
            raise ValueError('Profile must be calibrated for this exact queue_name')
        tray_option = profile.get('tray_option')
        if not tray_option or tray_option not in profile.get('cups_options',{}):
            raise ValueError('Profile must select its verified tray source option')
        capabilities = checked_run(['lpoptions','-p',args.queue,'-l']).stdout
        choices = {}
        for line in capabilities.splitlines():
            if ':' in line:
                key, values = line.split(':',1)
                choices[key.split('/')[0]] = {v.lstrip('*') for v in values.split()}
        for key,val in profile['cups_options'].items():
            if key in choices and str(val) not in choices[key]:
                raise ValueError(f'Queue does not advertise selected option {key}={val}')
        info = checked_run(['lpstat','-p',args.queue,'-l']).stdout
        if 'disabled' in info.lower():
            raise ValueError('Target queue disabled')
        model = checked_run(['lpstat','-l','-p',args.queue]).stdout
        ppd=Path('/etc/cups/ppd')/(args.queue+'.ppd')
        if ppd.is_file():
            model += ppd.read_text(errors='replace')
        if not re.search(r'epson|L805[08]',model,re.I):
            raise ValueError('Cannot identify target as Epson; inspect queue before submitting')
        pending={'index':index,'batch':batch['number'],'group':batch['group'],'side':side,'status':'submission_uncertain','started_at':dt.datetime.now().astimezone().isoformat()}
        state['events'].append(pending);write(folder/'state.json',state)
        result=checked_run(cmd)  # An error deliberately leaves an uncertain state.
        match=re.search(r'request id is (\S+)',result.stdout)
        pending.update(status='submitted',cups_job_id=match.group(1) if match else None)
        write(folder/'state.json',state)
        print(f'Submitted batch {batch["number"]} {side}; confirm physical output before advancing')


A4_MM = (210.0, 297.0)


def sheet_layout(count, aspect, page_mm=A4_MM, columns=None, scale=1.0):
    """Grid on A4 with zero gutters: pick columns so the cell aspect matches the images.

    scale>1 enlarges the auto-grid cell exactly (cells touch, leftover page margin stays blank)."""
    pw, ph = page_mm
    if columns:
        cols = max(1, columns)
        rows = max(1, round(cols*aspect*ph/pw))
        cw, ch = pw/cols, ph/rows
    else:
        best = None
        for c in range(1, count+1):
            r = max(1, round(c*aspect*ph/pw))
            cell = (pw/c)/(ph/r)
            err = round(abs(math.log(cell/aspect)), 6)
            key = (err, c, math.ceil(count/(c*r)))
            if best is None or key < best[0]:
                best = (key, c, r)
        cols0, rows0 = best[1], best[2]
        cw, ch = (pw/cols0)*scale, (ph/rows0)*scale
        cols = max(1, math.floor(pw/cw))
        rows = max(1, math.floor(ph/ch))
    capacity = cols*rows
    return {'columns': cols, 'rows': rows, 'capacity': capacity, 'pages': math.ceil(count/capacity), 'cell_mm': [cw, ch]}


def sheet_cell(index, columns, cell):
    cw, ch = cell
    col, row = index % columns, index // columns
    return (col*cw, row*ch, cw, ch)


def make_sheet_pdf(path, files, layout, page_mm, dpi, rotate=0):
    from reportlab.pdfgen import canvas
    from reportlab.lib.utils import ImageReader
    cols = layout['columns']
    cw, ch = layout['cell_mm']
    pixels = (max(1, round(cw*dpi/25.4)), max(1, round(ch*dpi/25.4)))
    c = canvas.Canvas(str(path), pagesize=(page_mm[0]*PT, page_mm[1]*PT), pageCompression=1)
    c.setTitle('A4 sheet, zero spacing')
    per_page = layout['capacity']
    for page in range(layout['pages']):
        # showPage 会重置画布状态：变换与白底必须每页重设
        c.translate(0, page_mm[1]*PT)
        c.scale(PT, -PT)
        c.setFillColorRGB(1, 1, 1)
        c.rect(0, 0, page_mm[0], page_mm[1], stroke=0, fill=1)
        for j, f in enumerate(files[page*per_page:(page+1)*per_page]):
            x, y, w, h = sheet_cell(j, cols, (cw, ch))
            im = fitted(f, pixels, 'contain', rotate)
            # 局部 y 翻转：与卡片流程 make_pdf 同款，否则图像上下镜像（-29 实印教训）
            c.saveState()
            c.translate(x, y+h); c.scale(1, -1)
            c.drawImage(ImageReader(im), 0, 0, width=w, height=h)
            c.restoreState()
        c.showPage()
    c.save()


def verify_printer(queue):
    info = checked_run(['lpstat','-p',queue,'-l']).stdout
    if 'disabled' in info.lower():
        raise ValueError('Target queue disabled')
    model = checked_run(['lpstat','-l','-p',queue]).stdout
    ppd = Path('/etc/cups/ppd')/(queue+'.ppd')
    if ppd.is_file():
        model += ppd.read_text(errors='replace')
    if not re.search(r'epson|L805[08]', model, re.I):
        raise ValueError('Cannot identify target as Epson; inspect queue before submitting')


def sheet(args):
    if not 0.1 <= args.scale <= 8:
        raise ValueError('--scale must be 0.1..8')
    front_dir = Path(args.front_dir).resolve()
    if not front_dir.is_dir():
        raise ValueError(f'Not a directory: {front_dir}')
    files = sorted(p for p in front_dir.iterdir() if p.is_file() and p.suffix.lower() in IMAGE_SUFFIXES)
    if not files:
        raise ValueError(f'No images found in {front_dir}')
    from PIL import Image
    aspects = sorted(im.size[0]/im.size[1] for im in (Image.open(f) for f in files))
    aspect = aspects[len(aspects)//2]
    layout = sheet_layout(len(files), aspect, columns=args.columns, scale=args.scale)
    out = Path(args.output).resolve()
    out.mkdir(parents=True, exist_ok=False)
    pdf = out/'sheet.pdf'
    make_sheet_pdf(pdf, files, layout, A4_MM, args.dpi, args.rotate)
    info = {'output': str(pdf), 'images': len(files), 'page_mm': list(A4_MM), 'spacing_mm': 0,
            'scale': args.scale, 'rotate': args.rotate, **layout}
    if args.queue:
        cmd = command({'cups_options': {'EPIJ_Size': '1'}}, args.queue, pdf)
        info['argv'] = cmd
        info['execute'] = args.execute
        if args.execute:
            verify_printer(args.queue)
            result = checked_run(cmd)
            m = re.search(r'request id is (\S+)', result.stdout)
            info['cups_job_id'] = m.group(1) if m else None
    print(json.dumps(info, ensure_ascii=False))


def parser():
    p=argparse.ArgumentParser(description=__doc__,formatter_class=argparse.RawDescriptionHelpFormatter); sub=p.add_subparsers(dest='cmd',required=True)
    b=sub.add_parser('prepare');b.add_argument('--front-dir');b.add_argument('--back-img')
    b.add_argument('--group',required=True);b.add_argument('--output',required=True);b.add_argument('--calibration',action='store_true')
    b.add_argument('--dpi',type=int,choices=(150,300,600),default=300);b.add_argument('--fit',choices=('cover','contain','exact'),default='contain');b.set_defaults(func=prepare)
    c=sub.add_parser('calibrate');c.add_argument('--samples');c.add_argument('--max-residual',type=float,default=.5);c.add_argument('--reset',action='store_true');c.set_defaults(func=calibrate)
    s=sub.add_parser('step');s.add_argument('--job',required=True);s.add_argument('--queue');s.add_argument('--execute',action='store_true');s.add_argument('--tray-loaded',action='store_true')
    s.add_argument('--confirm-output',action='store_true');s.add_argument('--confirm-dry',action='store_true');s.set_defaults(func=step)
    sh=sub.add_parser('sheet');sh.add_argument('--front-dir',required=True);sh.add_argument('--output',required=True);sh.add_argument('--queue')
    sh.add_argument('--execute',action='store_true');sh.add_argument('--columns',type=int);sh.add_argument('--dpi',type=int,choices=(150,300,600),default=300)
    sh.add_argument('--scale',type=float,default=1.0);sh.add_argument('--rotate',type=int,choices=(0,90,180,270),default=0);sh.set_defaults(func=sheet)
    return p


def main():
    args=parser().parse_args()
    args.func(args)


if __name__=='__main__':
    try:
        main()
    except (ValueError,KeyError,OSError,subprocess.SubprocessError) as exc:
        print(f'ERROR: {exc}',file=sys.stderr);sys.exit(2)
